# ---------------------------------------------------------------------------
# Dumping Tool configuration. Copy to .env and fill in the values.
# ---------------------------------------------------------------------------
NODE_ENV=production
PORT=8080
# Public URL of the dashboard (used in email links). On Render this is detected
# automatically from RENDER_EXTERNAL_URL.
APP_URL=https://your-app.example.com

# MongoDB stores users, jobs and dump metadata (MongoDB Atlas free M0 works).
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/dumping_tool?retryWrites=true&w=majority

# Required in production. Generate each with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
# Encrypts saved database passwords. Back it up: if it changes, saved
# connection passwords can no longer be decrypted and must be re-entered.
ENCRYPTION_KEY=

# First admin account (created only when the database has no users).
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me-please
ADMIN_NAME=Administrator

# Default timezone for schedules (IANA name).
DEFAULT_TIMEZONE=Asia/Kolkata

# --- Storage -----------------------------------------------------------------
# "local" keeps dumps on disk (needs a persistent volume);
# "s3" works with AWS S3, Backblaze B2, Cloudflare R2, MinIO, Supabase...
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./data/dumps
# S3_ENDPOINT=https://s3.us-east-005.backblazeb2.com
# S3_REGION=us-east-005
# S3_BUCKET=my-db-dumps
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=true
# S3_PREFIX=dumps

# --- Email -------------------------------------------------------------------
# console | smtp | brevo | resend
# (Render's free tier blocks SMTP ports: use brevo or resend there.)
EMAIL_PROVIDER=console
EMAIL_FROM=backups@example.com
EMAIL_FROM_NAME=Dumping Tool
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# BREVO_API_KEY=
# RESEND_API_KEY=

# --- Dump runner ---------------------------------------------------------------
MAX_CONCURRENT_DUMPS=2
DUMP_TIMEOUT_MINUTES=120
DEFAULT_RETENTION=7
# Override binary locations if they are not on PATH:
# PG_DUMP_PATH=/usr/lib/postgresql/18/bin/pg_dump
# MYSQLDUMP_PATH=/usr/bin/mysqldump
