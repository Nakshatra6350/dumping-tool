# -----------------------------------------------------------------------------
# DBRB infrastructure configuration. Copy to .env and adjust.
#
# Only what the server needs in order to BOOT lives here. Product behaviour
# (where backups are stored, S3 buckets and keys, whether sign-ups are open...)
# is NOT configured here: it is set in the admin panel and stored, encrypted
# where needed, in the database. See docs/CONFIGURATION.md.
# -----------------------------------------------------------------------------
NODE_ENV=development

# Public URLs of the web app and the API.
APP_URL=http://localhost:5173
API_URL=http://localhost:4000
API_PORT=4000

# Platform database (MySQL 8.4). The user must be able to create databases and
# users, because every tenant gets its own. Matches infra/docker-compose.dev.yml.
DATABASE_URL=mysql://root:dbrb_dev_root@127.0.0.1:3310/dbrb_platform
# Each tenant database is named <prefix><tenant id>.
TENANT_DB_PREFIX=dbrb_t_

REDIS_URL=redis://127.0.0.1:6380

# REQUIRED in production, 32+ characters each. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# MASTER_KEY protects every stored secret. Back it up: if it is lost, tenant
# databases and saved S3 keys can no longer be decrypted.
MASTER_KEY=
SIGNING_KEY=

SESSION_TTL_DAYS=7

# Directory for the "local disk" storage mode (relative to the repo root).
STORAGE_LOCAL_DIR=./data/storage

# Keep this off on a hosted, multi-tenant deployment (it blocks tenants from
# pointing the server at internal addresses). On for local dev / self-hosting.
# ALLOW_PRIVATE_NETWORK_TARGETS=true

# Email: "console" only logs; "smtp" sends. Locally, Mailpit catches everything
# at http://localhost:8025.
MAIL_DRIVER=smtp
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
MAIL_FROM=DBRB <no-reply@dbrb.local>

# Comma-separated emails that are platform owners. The first account always is.
PLATFORM_ADMIN_EMAILS=
