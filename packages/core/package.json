{
  "name": "@dbrb/core",
  "version": "0.1.0",
  "private": true,
  "description": "DBRB server-side domain: configuration, tenancy, encryption, settings, storage and audit.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:int": "vitest run --config vitest.int.config.ts",
    "db:generate": "drizzle-kit generate --config drizzle.platform.config.ts && drizzle-kit generate --config drizzle.tenant.config.ts",
    "db:migrate": "tsx src/cli/migrate.ts",
    "db:reset": "tsx src/cli/reset.ts",
    "dev:buckets": "tsx src/cli/dev-buckets.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1146.0",
    "@aws-sdk/lib-storage": "^3.1146.0",
    "@aws-sdk/s3-request-presigner": "^3.1146.0",
    "@dbrb/shared": "workspace:*",
    "dotenv": "^18.0.5",
    "drizzle-orm": "^0.45.3",
    "ioredis": "^6.0.0",
    "mysql2": "^3.24.5",
    "nodemailer": "^10.0.13",
    "pino": "^10.4.0",
    "ulid": "^3.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/nodemailer": "^8.0.2",
    "drizzle-kit": "^0.31.11",
    "pino-pretty": "^13.1.3"
  }
}
