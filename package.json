{
  "name": "dbrb",
  "version": "0.1.0",
  "private": true,
  "description": "DBRB: your database will be right back. A multi-tenant database backup and restore platform.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c magenta,cyan \"pnpm --filter @dbrb/api dev\" \"pnpm --filter @dbrb/web dev\"",
    "infra:up": "docker compose -f infra/docker-compose.dev.yml up -d && pnpm --filter @dbrb/core dev:buckets",
    "infra:down": "docker compose -f infra/docker-compose.dev.yml down",
    "infra:reset": "docker compose -f infra/docker-compose.dev.yml down -v",
    "db:generate": "pnpm --filter @dbrb/core db:generate",
    "db:migrate": "pnpm --filter @dbrb/core db:migrate",
    "db:reset": "pnpm --filter @dbrb/core db:reset",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r test",
    "test:int": "pnpm -r test:int"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.4",
    "concurrently": "^10.0.5",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
